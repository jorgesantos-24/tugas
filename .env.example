# Copie este ficheiro para ".env" e preencha.

# ---- Firebase ----
# Chave da conta de serviço (Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada)
# Guarde o ficheiro nesta pasta com este nome:
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json

# ---- Equipa ----
# E-mails que podem entrar no painel /admin (separados por vírgula). Cada um precisa de ter conta no site com o e-mail confirmado.
ADMIN_EMAILS=

# ---- BravoPay (depósitos PIX) ---- sem BRAVOPAY_API_KEY o site fica em modo DEMO
# Painel BravoPay -> API Keys (https://bravopay.club/dashboard/api-keys)
BRAVOPAY_API_KEY=
# Painel BravoPay -> Integrações -> Webhook (https://bravopay.club/dashboard/integracoes)
# URL do webhook: https://SEU-DOMINIO/api/webhooks/bravopay  (em localhost não é preciso: o site consulta a BravoPay sozinho)
BRAVOPAY_WEBHOOK_SECRET=

# ---- Depósitos ----
DEPOSIT_MIN=20

# ---- Apostas ao vivo ---- (segundos de espera antes de aprovar; recusa se houver gol nesse tempo)
LIVE_BET_DELAY=25
LIVE_CASHOUT_DELAY=25

# ---- Mercados calculados (Ambas Marcam, Placar Exato, Totais extra...) ----
DERIVED_MAX_STAKE=200
DERIVED_MAX_WIN=10000

# ---- Confirmação dos resultados de futebol (segunda fonte) ----
# Chave em https://dashboard.api-football.com (Account > My Access). Sem chave: resultados só da ESPN.
APIFOOTBALL_KEY=
# BoltOdds (odds ao vivo por WebSocket). Teste: node scripts/boltodds-teste.js
BOLTODDS_API_KEY=

# ---- Saques (pagos à mão pela equipa no painel /admin) ----
WITHDRAW_MIN=30
WITHDRAW_ETA=até 24 horas

# ---- Empresa (rodapé e páginas legais) ----
SITE_NAME=TUGAS
COMPANY_NAME=
COMPANY_CNPJ=
SPA_LICENSE=
SUPPORT_EMAIL=suporte@tugasbet.com
SUPPORT_PHONE=

# ---- Produção ----
# Endereço público do site (os links dos e-mails de confirmação/nova senha voltam para aqui). Adicione o domínio em
# Firebase > Authentication > Configurações > Domínios autorizados.
SITE_URL=
# Defina 1 se o site estiver atrás de um proxy (Nginx, Cloudflare, Render...) para ler o IP real dos visitantes
TRUST_PROXY=
PORT=3000
