# Copie este ficheiro para ".env" e preencha.

# ---- Firebase ----
# Chave da conta de serviço (Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada)
# Guarde o ficheiro nesta pasta com este nome:
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json

# ---- Equipa ----
# E-mails que podem entrar no painel /admin (separados por vírgula). Cada um precisa de ter conta no site com o e-mail confirmado.
ADMIN_EMAILS=

# ---- BravoPay (depósitos PIX) ---- sem BRAVOPAY_API_KEY o site fica em modo DEMO
# Painel BravoPay -> API Keys (https://bravopay.club/dashboard/api-keys)
BRAVOPAY_API_KEY=
# Painel BravoPay -> Integrações -> Webhook (https://bravopay.club/dashboard/integracoes)
# URL do webhook: https://SEU-DOMINIO/api/webhooks/bravopay  (em localhost não é preciso: o site consulta a BravoPay sozinho)
BRAVOPAY_WEBHOOK_SECRET=

# ---- Depósitos ----
DEPOSIT_MIN=20

# ---- Apostas ao vivo ---- espera (segundos) antes de aceitar uma aposta / cash out ao vivo, por modalidade.
# Recusa se houver gol ou suspensão nesse tempo. Mínimo 3. As apostas suspeitas aparecem no painel em "Ao vivo suspeitas".
LIVE_DELAY_SOCCER=8
LIVE_DELAY_HOCKEY=8
LIVE_DELAY_TENNIS=6
LIVE_DELAY_BASKETBALL=5
LIVE_DELAY_ESPORTS=5
# Liquidação antecipada: seleções já decididas (ex.: "mais de 2,5" com 3 gols, vencedor de um set terminado) são pagas
# sem esperar pelo fim do jogo, depois de os dados ficarem iguais EARLY_SETTLE_S segundos. Futebol/hóquei: só depois
# de a bet365 reabrir os mercados após o gol (VAR) e de estarem abertos EARLY_OPEN_S segundos. EARLY_SETTLE=0 desliga.
# EARLY_SETTLE_S=150
# EARLY_OPEN_S=60
# Futebol: resultado de prolongamento e penáltis na ESPN (0 = desliga; esses mercados ficam para a equipa)
# ESPN_RESULTS=1

# ---- Jogos, odds e resultados: MoviOdds (https://moviodds.com/doc) ----
# Funciona sem chave (limite por IP). Com chave grátis (conta no site deles) o limite passa a ser por chave.
MOVIODDS_KEY=
# Odds e estatísticas ao vivo por WebSocket (ligado por omissão). 0 = só pedidos normais, de 5 em 5 s.
# MOVIODDS_WS=0
# Máximo de navegadores ligados ao tempo real ao mesmo tempo (os outros ficam com a lista de 5 em 5 s).
# MAX_STREAMS=800

# ---- Mercados liquidados pela equipa (escanteios, cartões, jogadores...) ----
# O site não decide estes sozinho: depois do jogo aparecem no painel em "Mercados por liquidar".
MANUAL_MAX_STAKE=100
MANUAL_MAX_WIN=5000

# ---- Saques (pagos à mão pela equipa no painel /admin) ----
WITHDRAW_MIN=30
WITHDRAW_ETA=até 24 horas

# ---- Empresa (rodapé e páginas legais) ----
SITE_NAME=TUGAS
COMPANY_NAME=
COMPANY_CNPJ=
SPA_LICENSE=
SUPPORT_EMAIL=suporte@tugasbet.com
SUPPORT_PHONE=

# ---- Produção ----
# Endereço público do site (os links dos e-mails de confirmação/nova senha voltam para aqui). Adicione o domínio em
# Firebase > Authentication > Configurações > Domínios autorizados.
SITE_URL=
# Domínio principal (ex.: tugasbet.com): os endereços antigos *.web.app / *.firebaseapp.com redirecionam para ele
CANONICAL_HOST=
# Defina 1 se o site estiver atrás de um proxy (Nginx, Cloudflare, Render...) para ler o IP real dos visitantes
TRUST_PROXY=
PORT=3000
