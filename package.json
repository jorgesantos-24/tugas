{
  "name": "tugas",
  "version": "1.0.0",
  "private": true,
  "description": "Casa de apostas com jogos e odds ao vivo, Firebase e pagamentos PIX (BravoPay)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev.js",
    "verificar": "node scripts/verificar.js",
    "testar": "node scripts/testar-mercados.js",
    "testar:tenis": "node scripts/testar-tenis.js",
    "testar:futebol": "node --max-old-space-size=4096 scripts/testar-futebol.js",
    "auditar": "node --max-old-space-size=4096 scripts/auditar-odds.js",
    "deploy": "node scripts/deploy.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "tesseract.js": "^5.1.1"
  }
}
